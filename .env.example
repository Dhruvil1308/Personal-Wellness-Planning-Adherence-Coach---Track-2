# Copy to .env.local and fill in. Never commit the real file.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6

# Short conversational generations (coach replies).
LLM_MAX_TOKENS=200
# Structured JSON generations need their own, larger ceilings.
LLM_MAX_TOKENS_PLAN=2600
LLM_MAX_TOKENS_SUMMARY=800
