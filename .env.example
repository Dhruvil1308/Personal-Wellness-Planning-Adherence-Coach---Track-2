# Copy to .env.local and fill in. Never commit the real file.

# ---------------------------------------------------------------------------
# Planning / coaching AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6

# Short conversational generations (coach replies, reminder scripts).
LLM_MAX_TOKENS=200
# Structured JSON generations need their own, larger ceilings.
LLM_MAX_TOKENS_PLAN=2600
LLM_MAX_TOKENS_SUMMARY=800

# ---------------------------------------------------------------------------
# Gujarati reminder calls — Vobiz (telephony) + Sarvam (voice)
# ---------------------------------------------------------------------------
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=...
# Caller ID. Must be a number your Vobiz account is allowed to dial out from.
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

SARVAM_API_KEY=sk_...
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_STT_MODEL=saaras:v3
# Slightly under normal pace — a phone reminder has to land the first time.
SARVAM_TTS_PACE=0.95

# --- how Vobiz reaches this server ---------------------------------------
# The app listens on VOICE_HOST:VOICE_PORT; ngrok publishes NGROK_DOMAIN and
# forwards to it. NGROK_DOMAIN is handed to Vobiz as the answer/hangup/audio
# URLs — PUBLIC_BASE_URL is only the local address, and is never given out.
#   terminal 1:  npm run dev
#   terminal 2:  npm run tunnel
# Point the Vobiz application's Answer and Hangup URLs at:
#   https://<your-domain>/telephony/answer
#   https://<your-domain>/telephony/hangup
# Without NGROK_DOMAIN the app renders and previews audio but refuses to dial.
VOICE_HOST=0.0.0.0
VOICE_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
NGROK_DOMAIN=https://your-name.ngrok-free.dev
NGROK_AUTHTOKEN=

# --- reminder tuning (all optional) ---
# Silence prepended to the audio, so the agent speaks N seconds after pickup.
REMINDER_LEAD_SILENCE_SECONDS=2
REMINDER_TICK_MS=30000
REMINDER_LEAD_MINUTES=0
# A reminder later than this is expired rather than called at the wrong hour.
REMINDER_MAX_LATE_MINUTES=30
REMINDER_MAX_ATTEMPTS=2
REMINDER_RING_TIMEOUT=30
# Don't call about something already checked in.
REMINDER_SKIP_IF_CHECKED_IN=true
# Record a short spoken reply and transcribe it with Saaras. Off by default:
# the specified flow is remind-then-hang-up.
REMINDER_CAPTURE_RESPONSE=false
# Set to false to drive reminders from an external cron via POST /api/reminders/tick.
REMINDER_SCHEDULER_ENABLED=true
